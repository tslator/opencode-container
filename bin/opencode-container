#!/usr/bin/env bash
#
# OpenCode Container wrapper script
# Add this directory to your PATH to run the container-isolated OpenCode from anywhere
#
# Uses podman or docker (first found), or the engine named by $CONTAINER_ENGINE.
#
# Options:
#   -w, --websearch     Enable web search (sets OPENCODE_ENABLE_EXA=1)
#   -e, --experimental  Enable experimental features (sets OPENCODE_EXPERIMENTAL=1 and OPENCODE_ENABLE_EXPERIMENTAL_MODELS=1)
#   -u, --update-config Overwrite ~/.opencode-container/config/ files with repo versions
#   --herdr             Start OpenCode inside a herdr pane (herdr multiplexer in image)
#   --beads             Run `bd init` on first launch in workspaces without .beads/
#   --bdui              Start the beads-ui web server in-container; publish a
#                       per-workspace 127.0.0.1 port and print the URL
#   --bdui-port N       Override the host port used by --bdui
#   --memory            Set memory limit (default: 4g, e.g., --memory 8g)
#   --cpus              Set CPU count (default: 4, e.g., --cpus 8)
#   --host-access       Add the engine's host alias so the container can reach host services
#   --opencode-help     Show OpenCode's own CLI options (runs the container with --help)
#   -h, --help          Show this help
#
# Subcommands:
#   skills <installer args...>
#                       Manage the baked my-skills library via the in-image
#                       installer (list|status|enable|disable|gate|...).
#                       --global edits ~/.opencode-container/config/opencode.json;
#                       --project DIR (default: cwd) edits that project's config.
#
# Any other flags/commands (e.g. -m/--model, -c/--continue, -s/--session,
# auth logout, run "msg") are passed through to the OpenCode CLI.

set -e

usage() {
    cat <<'EOF'
opencode-container — run OpenCode in a container

Usage: opencode-container [options] [opencode args...]
       opencode-container skills <installer args...>

Options:
  -w, --websearch      Enable web search (sets OPENCODE_ENABLE_EXA=1)
  -e, --experimental   Enable experimental features (sets OPENCODE_EXPERIMENTAL=1
                       and OPENCODE_ENABLE_EXPERIMENTAL_MODELS=1)
  -u, --update-config  Overwrite ~/.opencode-container/config/ files with repo versions
      --herdr          Start OpenCode inside a herdr pane (herdr multiplexer in image)
      --beads          Run `bd init` on first launch in workspaces without .beads/
      --bdui           Start the beads-ui web server in the container and publish
                       a per-workspace 127.0.0.1 port (prints the URL)
      --bdui-port N    Override the host port used by --bdui
      --memory SIZE    Set memory limit (default: 4g, e.g., --memory 8g)
      --cpus N         Set CPU count (default: 4, e.g., --cpus 8)
      --host-access    Add the engine's host alias so the container can reach host services
      --opencode-help  Show OpenCode's own CLI options (runs the container with --help)
  -h, --help           Show this help

Subcommands:
  skills <installer args...>
      Manage the baked my-skills library with the in-image installer
      (list|status|enable|disable|gate|...). --global edits the global
      config (~/.opencode-container/config/opencode.json); --project DIR
      (default: cwd) edits that project's opencode.json. Runs offline.

Environment:
  CONTAINER_ENGINE           podman or docker (auto-detected if unset)
  OPENCODE_WORKSPACE         workspace directory (default: current directory)
  MEMORY_LIMIT               default for --memory
  CPU_LIMIT                  default for --cpus
  OPENCODE_CONTAINER_HERDR   set to 1 to enable --herdr by default
  OPENCODE_CONTAINER_BEADS   set to 1 to enable --beads by default
  OPENCODE_CONTAINER_BDUI    set to 1 to enable --bdui by default
  OPENCODE_CONTAINER_BDUI_PORT  default host port for --bdui

Any other flags/commands (e.g. -m/--model, -c/--continue, -s/--session,
auth logout, run "msg") are passed through to the OpenCode CLI.
Run `opencode-container --opencode-help` to see OpenCode's own options.
EOF
}

UPDATE_CONFIG=0
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

ENV_ARGS=()
MOUNT_ARGS=()
HOST_ARGS=()
HOST_ACCESS=0
MEMORY_LIMIT="${MEMORY_LIMIT:-4g}"
CPU_LIMIT="${CPU_LIMIT:-4}"
HERDR_OPTIN="${OPENCODE_CONTAINER_HERDR:-0}"
BEADS_OPTIN="${OPENCODE_CONTAINER_BEADS:-0}"
BDUI_OPTIN="${OPENCODE_CONTAINER_BDUI:-0}"
BDUI_PORT="${OPENCODE_CONTAINER_BDUI_PORT:-}"
PORT_ARGS=()
OPENCODE_HELP=0

# Parse wrapper options first so -h/--help works without an engine or state dirs.
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --opencode-help)
            OPENCODE_HELP=1
            shift
            ;;
        -u|--update-config)
            UPDATE_CONFIG=1
            shift
            ;;
        --herdr)
            HERDR_OPTIN=1
            shift
            ;;
        --beads)
            BEADS_OPTIN=1
            shift
            ;;
        -w|--websearch)
            ENV_ARGS+=(--env "OPENCODE_ENABLE_EXA=1")
            shift
            ;;
        -e|--experimental)
            ENV_ARGS+=(--env "OPENCODE_EXPERIMENTAL=1" --env "OPENCODE_ENABLE_EXPERIMENTAL_MODELS=1")
            shift
            ;;
        --memory)
            [ "$#" -ge 2 ] || { echo "error: --memory requires a value" >&2; exit 2; }
            MEMORY_LIMIT="$2"
            shift 2
            ;;
        --cpus)
            [ "$#" -ge 2 ] || { echo "error: --cpus requires a value" >&2; exit 2; }
            CPU_LIMIT="$2"
            shift 2
            ;;
        --host-access)
            HOST_ACCESS=1
            shift
            ;;
        --bdui)
            BDUI_OPTIN=1
            shift
            ;;
        --bdui-port)
            [ "$#" -ge 2 ] || { echo "error: --bdui-port requires a value" >&2; exit 2; }
            BDUI_PORT="$2"
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

ENGINE="${CONTAINER_ENGINE:-}"
if [ -z "$ENGINE" ]; then
    if command -v podman >/dev/null 2>&1; then
        ENGINE=podman
    elif command -v docker >/dev/null 2>&1; then
        ENGINE=docker
    else
        echo "Error: no container engine found; install podman/docker or set CONTAINER_ENGINE" >&2
        exit 1
    fi
fi

if [ "$HOST_ACCESS" = 1 ]; then
    case "$ENGINE" in
        podman) HOST_ARGS+=(--add-host "host.containers.internal:host-gateway") ;;
        *)      HOST_ARGS+=(--add-host "host.docker.internal:host-gateway") ;;
    esac
fi

USERNS_ARGS=()
if [ "$ENGINE" = podman ]; then
    # ponytail: keep-id is rootless-only; rootful podman (sudo) will reject it
    USERNS_ARGS=(--userns=keep-id)
fi

# --opencode-help: show the OpenCode CLI help from the image itself; skip
# state-dir setup, config copy, proxy forwarding, and secrets since help
# needs none of them. No --workdir: podman rejects a workdir missing from
# the image, and help output does not depend on the working directory.
if [ "$OPENCODE_HELP" = 1 ]; then
    exec "$ENGINE" run --rm -i opencode-container:latest --help
fi

ocd_dir="$HOME/.opencode-container"
# One-time migration from the pre-rename docker-only state dir
if [ -d "$HOME/.opencode-docker" ] && [ ! -d "$ocd_dir" ]; then
    mv "$HOME/.opencode-docker" "$ocd_dir"
fi
repo_dir="${OPENCODE_CONTAINER_REPO:-$(cd "$SCRIPT_DIR/.." && pwd)}"

# .config must exist before the engine mounts config at /app/.config/opencode;
# otherwise the engine creates it as container-root (uid 100000) and herdr
# cannot create /app/.config/herdr later.
mkdir -p "$ocd_dir/.config" "$ocd_dir/config" "$ocd_dir/secrets"
chmod 700 "$ocd_dir" "$ocd_dir/config" "$ocd_dir/secrets"

# skills subcommand: one-shot installer runs against the image-baked
# my-skills checkout (no network, no --host-access). Host paths are
# translated to their in-container locations: --global maps to the global
# config file, --project DIR (default: cwd) mounts DIR at /workspace.
if [ "${1:-}" = "skills" ]; then
    shift
    SKILL_ARGS=()
    SKILL_GLOBAL=0
    SKILL_WS=""
    args=("$@")
    for ((i = 0; i < ${#args[@]}; i++)); do
        case "${args[i]}" in
            --global) SKILL_GLOBAL=1 ;;
            --project)
                i=$((i + 1))
                [ "$i" -lt "${#args[@]}" ] || { echo "error: --project requires a directory" >&2; exit 2; }
                SKILL_WS="$(readlink -f "${args[i]}")"
                SKILL_ARGS+=(--project /workspace)
                ;;
            *) SKILL_ARGS+=("${args[i]}") ;;
        esac
    done
    if [ "$SKILL_GLOBAL" = 1 ]; then
        # enable/disable write via the native skills key; --config is the
        # installer's fixed-path target for the mounted global config.
        case "${SKILL_ARGS[0]:-}" in
            enable|disable) SKILL_ARGS+=(--config /app/.config/opencode/opencode.json) ;;
        esac
        SKILL_WS=""
    elif [ -z "$SKILL_WS" ]; then
        SKILL_WS="$(readlink -f "$(pwd)")"
        SKILL_ARGS+=(--project /workspace)
    fi
    if [ -n "$SKILL_WS" ] && [ ! -d "$SKILL_WS" ]; then
        echo "Error: workspace path is not an existing directory: $SKILL_WS" >&2
        exit 1
    fi
    SKILL_MOUNTS=(-v "$ocd_dir:/app:rw,Z" -v "$ocd_dir/config:/app/.config/opencode:rw,Z")
    SKILL_WORKDIR=/app
    if [ -n "$SKILL_WS" ]; then
        SKILL_MOUNTS+=(-v "$SKILL_WS:/workspace:rw,Z")
        SKILL_WORKDIR=/workspace
    fi
    exec "$ENGINE" run --rm -i \
        "${USERNS_ARGS[@]}" \
        --workdir "$SKILL_WORKDIR" \
        --read-only \
        --tmpfs /tmp:exec,size=512m,mode=1777 \
        --cap-drop=ALL \
        --security-opt=no-new-privileges \
        --env PYTHONDONTWRITEBYTECODE=1 \
        "${SKILL_MOUNTS[@]}" \
        --entrypoint /usr/bin/python3 \
        opencode-container:latest \
        /opt/my-skills/scripts/install_skills.py "${SKILL_ARGS[@]}"
fi

# Remove env files created by older launcher versions; bootstrap reads mounted secrets.
rm -f "$ocd_dir/.env"

# Default workspace to current directory if not specified
WORKSPACE="${OPENCODE_WORKSPACE:-$(pwd)}"

if [ ! -d "$WORKSPACE" ]; then
    echo "Error: workspace path is not an existing directory: $WORKSPACE" >&2
    exit 1
fi
WORKSPACE="$(readlink -f "$WORKSPACE")"

# Per-project state. OpenCode keeps sessions in XDG_DATA_HOME
# (/app/.local/share) and TUI tab/prompt state in XDG_STATE_HOME
# (/app/.local/state), and both key projects by cwd; since every host directory
# mounts at /workspace, shared dirs would merge session lists and restore
# another workspace's session tab on startup. Mount one pair per workspace path.
ws_hash="$(printf '%s' "$WORKSPACE" | sha1sum 2>/dev/null | cut -c1-12)"
[ -n "$ws_hash" ] || ws_hash="$(printf '%s' "$WORKSPACE" | cksum | tr -d ' ')"
ws_slug="$(basename "$WORKSPACE" | tr -c 'a-zA-Z0-9._\n-' '-')-$ws_hash"
ws_root="$ocd_dir/projects/$ws_slug"
# One-time migration from the flat layout (store lived in $ws_root directly)
if [ -d "$ws_root/opencode" ] && [ ! -d "$ws_root/share" ]; then
    mkdir -p "$ws_root/share"
    for entry in "$ws_root"/*; do
        [ "$entry" = "$ws_root/share" ] && continue
        mv "$entry" "$ws_root/share/"
    done
fi
mkdir -p "$ws_root/share" "$ws_root/state"

reject_proxy_credentials() {
    case "$1" in
        *://*@*)
            echo "error: proxy URLs with embedded credentials are not supported" >&2
            exit 2
            ;;
    esac
}

if [ -d "$repo_dir/config" ]; then
  if [ "$UPDATE_CONFIG" = 1 ]; then
    cp -a "$repo_dir/config/." "$ocd_dir/config/"
  else
    cp -a --update=none "$repo_dir/config/." "$ocd_dir/config/"
  fi
fi

# Forward host proxy settings (both cases; tools differ on which they read)
EFF_HTTP_PROXY="${HTTP_PROXY:-${http_proxy:-}}"
EFF_HTTPS_PROXY="${HTTPS_PROXY:-${https_proxy:-}}"
EFF_NO_PROXY="${NO_PROXY:-${no_proxy:-}}"
[ -n "$EFF_HTTP_PROXY" ] && reject_proxy_credentials "$EFF_HTTP_PROXY"
[ -n "$EFF_HTTPS_PROXY" ] && reject_proxy_credentials "$EFF_HTTPS_PROXY"
[ -n "$EFF_HTTP_PROXY" ] && ENV_ARGS+=(-e "HTTP_PROXY=$EFF_HTTP_PROXY" -e "http_proxy=$EFF_HTTP_PROXY")
[ -n "$EFF_HTTPS_PROXY" ] && ENV_ARGS+=(-e "HTTPS_PROXY=$EFF_HTTPS_PROXY" -e "https_proxy=$EFF_HTTPS_PROXY")
[ -n "$EFF_NO_PROXY" ] && ENV_ARGS+=(-e "NO_PROXY=$EFF_NO_PROXY" -e "no_proxy=$EFF_NO_PROXY")

# Forward the beads/herdr opt-ins (set via flags or host environment)
[ "$HERDR_OPTIN" = 1 ] && ENV_ARGS+=(--env "OPENCODE_CONTAINER_HERDR=1")
[ "$BEADS_OPTIN" = 1 ] && ENV_ARGS+=(--env "OPENCODE_CONTAINER_BEADS=1")

# bdui (beads-ui web server) runs inside the container (bootstrap starts it);
# publish a per-workspace host port. Hash collisions between concurrent
# workspaces are possible; --bdui-port overrides.
if [ "$BDUI_OPTIN" = 1 ]; then
    if [ -z "$BDUI_PORT" ]; then
        BDUI_PORT=$((3000 + $(printf '%s' "$WORKSPACE" | cksum | cut -d' ' -f1) % 1000))
    fi
    ENV_ARGS+=(--env "OPENCODE_CONTAINER_BDUI=1")
    PORT_ARGS+=(-p "127.0.0.1:${BDUI_PORT}:3000")
    echo "bdui: http://127.0.0.1:${BDUI_PORT}/ (workspace: $WORKSPACE)" >&2
fi

# Dev override: binaries in ~/.opencode-container/bin take precedence over the
# image-baked tools (bd, herdr) without rebuilding the image.
if [ -d "$ocd_dir/bin" ]; then
    MOUNT_ARGS+=(-v "$ocd_dir/bin:/opt/host-tools:ro,Z")
    ENV_ARGS+=(--env "PATH=/opt/host-tools:/usr/local/bin:/usr/bin")
fi

if [ -t 0 ]; then
    RUN_FLAGS="-it"
else
    RUN_FLAGS="-i"
fi

if [ "$HOST_ACCESS" = 1 ]; then
    echo "warning: host access is enabled; OpenCode can reach host services through the container gateway" >&2
fi

# ponytail: --memory/--cpus need cgroup v2 + systemd user session, else rootless podman warns and ignores them
"$ENGINE" run --rm $RUN_FLAGS \
    "${USERNS_ARGS[@]}" \
    --workdir /workspace \
    --read-only \
    --tmpfs /tmp:exec,size=512m,mode=1777 \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --memory="${MEMORY_LIMIT}" \
    --cpus="${CPU_LIMIT}" \
    "${ENV_ARGS[@]}" \
    "${HOST_ARGS[@]}" \
    "${PORT_ARGS[@]}" \
    "${MOUNT_ARGS[@]}" \
    -v "$HOME/.opencode-container:/app:rw,Z" \
    -v "$HOME/.opencode-container/config:/app/.config/opencode:rw,Z" \
    -v "$HOME/.opencode-container/secrets:/run/secrets:ro,Z" \
    -v "$ws_root/share:/app/.local/share:rw,Z" \
    -v "$ws_root/state:/app/.local/state:rw,Z" \
    -v "$WORKSPACE:/workspace:rw,Z" \
    opencode-container:latest "$@"
